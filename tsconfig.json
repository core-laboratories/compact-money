{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"noEmit": true,
		"types": ["node"]
	},
	"include": ["src", "tests", "*.ts"]
}
